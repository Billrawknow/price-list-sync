# =====================================================================
#  PRICE LIST SYNC - SETTINGS
#  Change the words after each = sign, then save (Ctrl+S) and close.
#  Lines starting with # are notes.
# =====================================================================

SHOP_NAME=Mlimani Hardware & Building Supplies

# --- Your files -------------------------------------------------------
# Your price sheet (Excel). Just the name if it's in this folder's "shop" folder,
# or the full path, e.g. C:/Users/Shop/Documents/Mlimani price sheet.xlsx
SHOP_PRICE_SHEET=shop/Mlimani price sheet.xlsx
# Where you save the suppliers' price lists: one folder per supplier,
# each list named by its date, e.g. price_lists/kapsoit-plumbing/2026-11-30.pdf
PRICE_LISTS_FOLDER=price_lists

# --- Your markups (% on top of cost), by the Category in your price sheet -----
MARKUPS=Cement:12, Steel:15, Roofing:18, Timber:20, Hardware:30, Plumbing:25, Paint:25
# For any category not listed above:
DEFAULT_MARKUP=20
# Round suggested selling prices up to the nearest (shillings):
ROUND_TO=10

# --- Who gets the Monday email (separate several with commas) ---------
REPORT_TO=owner@example.com, manager1@example.com, manager2@example.com

# --- The Gmail account that sends it ------------------------------------
# App Password: myaccount.google.com > Security > App passwords (16 letters).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- When it runs ------------------------------------------------------
RUN_DAY=MON
RUN_TIME=07:00

# --- Test mode: yes = send ONLY to TEST_EMAIL_TO, subject marked [TEST] -----
TEST_MODE=no
TEST_EMAIL_TO=

# --- AI key for reading PDF price lists ----------------------------------
ANTHROPIC_API_KEY=
